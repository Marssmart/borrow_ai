<?xml version="1.0" encoding="utf-8"?>
<!-- Downloaded models are large and re-downloadable, so they stay out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
